# 复制本文件为项目根目录下的 .env 并填写真实密钥（.env 已被 .gitignore 忽略）

# --- MySQL 8.0 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_study
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=smartstudy_root_123

# --- Redis 7 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=smartstudy_redis_123

# --- JWT 安全配置（生产/答辩前请替换为至少32位随机字符串） ---
JWT_SECRET=change-this-to-a-secure-256bit-secret-key-for-smart-study-platform
JWT_EXPIRE_HOURS=24

# --- 默认初始化管理员账号（后端启动时若不存在则自动创建） ---
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@123456

# --- AI 大模型配置（OpenAI 兼容协议，默认指向 DeepSeek） ---
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30

# --- 邮件提醒配置（QQ / 163 邮箱 SMTP，留空则降级为仅日志/站内提醒） ---
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
